ZHIXUEHUAN_DATABASE_URL=sqlite:///./data/app.db
ZHIXUEHUAN_LLM_ENABLED=false
ZHIXUEHUAN_LLM_PROVIDER=openai_compatible
ZHIXUEHUAN_LLM_MODEL=gpt-4.1-mini
ZHIXUEHUAN_LLM_API_KEY=replace-with-your-api-key
